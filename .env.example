# ───────────────────────────── Dockbare configuration ─────────────────────────────
# Copy to .env next to docker-compose.yml. Everything here is read at start-up.
# Generate strong values with:  docker run --rm fluttered/dockbare python -m dockbare gen-secret

# --- Admin login (required; all access is blocked until this is set) ---------------
DOCKBARE_ADMIN_USER=admin
DOCKBARE_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Prefer a hash instead of the plain password (python -m dockbare hash-password):
# DOCKBARE_ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...

# Optional second factor (python -m dockbare totp-setup prints a secret + otpauth URI)
# DOCKBARE_TOTP_SECRET=JBSWY3DPEHPK3PXP

# --- Keys --------------------------------------------------------------------------
# Signs session cookies and encrypts stored remote credentials. Keep it stable.
DOCKBARE_SECRET_KEY=replace-with-a-long-random-string

# System-wide backup encryption key. New backups are encrypted with it before they
# leave the host; remotes only ever see ciphertext. LOSING THIS KEY MEANS LOSING
# ACCESS TO ENCRYPTED BACKUPS - store it in your password manager.
DOCKBARE_ENCRYPTION_KEY=replace-with-a-long-random-passphrase

# --- Identity ----------------------------------------------------------------------
# Name of this installation. Used as folder on shared remotes (<base>/<instance>/<volume>)
# and shown to peers. Generated if missing - set it so it survives a reinstall.
DOCKBARE_INSTANCE_NAME=server-a

# --- Remotes (optional; 1..9) ------------------------------------------------------
# Remotes defined here are created at start-up and locked in the UI. Keep them in .env
# if you want a disaster recovery to be "restore .env, docker compose up, open Recovery".
# Replace 1 with 2..9 for more remotes. Fields (same for every remote):
#   NAME            display name                            (default: "Remote <n> (<host>)")
#   TYPE            ftp | sftp                              (default: ftp)
#   HOST, PORT      server; port defaults to 21 (ftp) / 22 (sftp)
#   USER, PASSWORD  login
#   PATH            base directory on the server; never the root directory
#   INSTANCE_DIR    true = store under <PATH>/<instance>/<volume>, false = <PATH>/<volume> (default: true)
#   ENABLED         true | false                            (default: true)
# FTP only:
#   TLS             none | explicit | implicit              (default: explicit = FTPS on port 21;
#                   none = plain FTP, password in clear text; implicit = FTPS on port 990)
#   VERIFY_TLS      true | false  verify the server certificate (default: true; false for self-signed)
#   PASSIVE         true | false  passive mode              (default: true)
#   NAT_FIX         true | false  ignore the address the server sends for passive data connections
# SFTP only:
#   PRIVATE_KEY_FILE  path to an OpenSSH private key (instead of PASSWORD), e.g. /data/id_ed25519
#   KEY_PASSPHRASE    passphrase of that key
#   HOST_KEY          SHA256:... pin of the server's host key (learned on first successful test if empty)
#
# Example 1: plain FTP on a NAS (no TLS)
# DOCKBARE_REMOTE_1_NAME=Home NAS
# DOCKBARE_REMOTE_1_TYPE=ftp
# DOCKBARE_REMOTE_1_HOST=nas.example.com
# DOCKBARE_REMOTE_1_PORT=21
# DOCKBARE_REMOTE_1_USER=backup
# DOCKBARE_REMOTE_1_PASSWORD=
# DOCKBARE_REMOTE_1_PATH=/dockbare
# DOCKBARE_REMOTE_1_TLS=none
#
# Example 2: FTPS with a self-signed certificate
# DOCKBARE_REMOTE_2_TYPE=ftp
# DOCKBARE_REMOTE_2_HOST=ftp.example.com
# DOCKBARE_REMOTE_2_USER=backup
# DOCKBARE_REMOTE_2_PASSWORD=
# DOCKBARE_REMOTE_2_PATH=/dockbare
# DOCKBARE_REMOTE_2_TLS=explicit
# DOCKBARE_REMOTE_2_VERIFY_TLS=false
#
# Example 3: SFTP (Hetzner Storage Box) with a key file
# DOCKBARE_REMOTE_3_NAME=Hetzner Storage Box
# DOCKBARE_REMOTE_3_TYPE=sftp
# DOCKBARE_REMOTE_3_HOST=u123456.your-storagebox.de
# DOCKBARE_REMOTE_3_PORT=23
# DOCKBARE_REMOTE_3_USER=u123456
# DOCKBARE_REMOTE_3_PATH=/backups/dockbare
# DOCKBARE_REMOTE_3_PRIVATE_KEY_FILE=/data/id_ed25519
# DOCKBARE_REMOTE_3_HOST_KEY=SHA256:...

# --- Peers (optional) --------------------------------------------------------------
# Other Dockbare instances read this one's status with this token (Peers page shows it).
# Generated if missing.
# DOCKBARE_PEER_TOKEN=
# Instances this one watches (1..9); locked in the UI when set here.
# DOCKBARE_PEER_1_NAME=Server B
# DOCKBARE_PEER_1_URL=https://backup.otherserver.com
# DOCKBARE_PEER_1_TOKEN=                     # that instance's DOCKBARE_PEER_TOKEN
# DOCKBARE_PEER_1_INTERVAL=5                 # minutes
# DOCKBARE_PEER_1_THRESHOLD=3                # failed checks before "peer down"
# DOCKBARE_PEER_1_ALERT_ON_PROBLEMS=true

# --- Deployment (read by docker compose, not by the app) ---------------------------
# Used by both compose files for variable substitution.
# PROXY_NETWORK=proxy-network              # existing reverse-proxy network; unset = Docker default bridge
# DOCKBARE_HOST=backup.example.com
# DOCKBARE_BACKUPS_PATH=/srv/dockbare/backups   # docker-compose.yml: host directories
# DOCKBARE_DATA_PATH=/srv/dockbare/data
# DOCKBARE_DATA_VOLUME=dockbare_data            # docker-compose.portainer.yml: named Docker volumes
# DOCKBARE_BACKUPS_VOLUME=dockbare_backups
# DOCKBARE_BIND=127.0.0.1                  # docker-compose.yml only: host address to publish on (0.0.0.0 = public)
# DOCKBARE_BUILD=2026-10-13                # optional tag for the locally built image
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# --- Network -----------------------------------------------------------------------
# Set to true when running behind a reverse proxy so the real client IP/scheme are used.
DOCKBARE_BEHIND_PROXY=false
# auto = Secure cookie flag only on HTTPS requests; true/false to force.
DOCKBARE_SECURE_COOKIES=auto
# DOCKBARE_PORT=5000                       # port inside the container and published on the host
# DOCKBARE_LISTEN=0.0.0.0                  # bind address inside the container (leave as is)

# --- Sessions & login throttling ----------------------------------------------------
# DOCKBARE_SESSION_IDLE_MINUTES=720
# DOCKBARE_SESSION_MAX_HOURS=168
# DOCKBARE_LOGIN_MAX_ATTEMPTS=5
# DOCKBARE_LOGIN_WINDOW_MINUTES=15

# --- Notification channels (optional) ---------------------------------------------
# Everything here can also be set in the UI (Settings → Notifications). Values given
# here take precedence and are shown as locked in the UI. A channel configured via
# .env is enabled unless DOCKBARE_<CHANNEL>_ENABLED=false.
# DOCKBARE_SMTP_HOST=smtp.example.com
# DOCKBARE_SMTP_PORT=587
# DOCKBARE_SMTP_SECURITY=starttls          # starttls | ssl | none
# DOCKBARE_SMTP_USER=dockbare@example.com
# DOCKBARE_SMTP_PASSWORD=
# DOCKBARE_SMTP_FROM=dockbare@example.com
# DOCKBARE_SMTP_TO=you@example.com,ops@example.com
# DOCKBARE_NTFY_URL=https://ntfy.sh
# DOCKBARE_NTFY_TOPIC=my-backups
# DOCKBARE_NTFY_TOKEN=
# DOCKBARE_WEBHOOK_URL=https://hooks.example.com/dockbare
# DOCKBARE_WEBHOOK_SECRET=

# --- Misc --------------------------------------------------------------------------
# Time zone for schedules and reports.
TZ=Europe/Berlin
# Image used for the helper containers that mount volumes (default: the Dockbare image itself).
# DOCKBARE_HELPER_IMAGE=alpine:3.20
# DOCKBARE_LOG_LEVEL=INFO
